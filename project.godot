; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Fleshdrive"
config/version="0.1.0-playtest.1"
run/main_scene="res://Scenes/startup_splash.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

AudioEffects="*res://Scripts/sfx_manager.gd"
VisualEffects="*res://Scripts/vfx_manager.gd"
ProjectilePool="*res://Scripts/projectile_pool.gd"
GameSettings="*res://Scripts/settings_manager.gd"
MetaProgression="*res://Scripts/meta_progression.gd"
UIPolish="*res://Scripts/ui_polish.gd"
BalanceDatabase="*res://Scripts/balance/balance_database.gd"
CombatPipeline="*res://Scripts/combat/combat_pipeline.gd"
PerformanceBudget="*res://Scripts/performance/performance_budget.gd"
SceneLifecycle="*res://Scripts/lifecycle/scene_lifecycle_guard.gd"
RunTelemetry="*res://Scripts/telemetry/run_telemetry.gd"
GameFlow="*res://Scripts/state/game_flow_coordinator.gd"
SaveRepository="*res://Scripts/save/save_repository.gd"
RuntimePool="*res://Scripts/performance/runtime_pool.gd"
InkCrimsonVisualSystem="*res://Scripts/visual/ink_crimson_visual_system.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=3
window/stretch/mode="viewport"
window/stretch/aspect="expand"
window/size/min_width=960
window/size/min_height=540

[global_group]

enemies=""
player=""
pickup_container=""

[gui]

theme/custom="res://Resources/Themes/fleshdrive_theme.tres"

